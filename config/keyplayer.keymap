#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap0: keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Windows";
            bindings = < 
          &kp ESC   &kp TILDE      &kp N1    &kp N2    &kp N3   &kp N4    &kp N5    &kp N6     &kp N7    &kp N8    &kp N9   &kp N0     &kp MINUS   &kp EQUAL            &kp BSPC             &kp DEL
          &trans    &kp TAB        &kp Q               &kp W    &kp E     &kp R     &kp T      &kp Y     &kp U     &kp I    &kp O      &kp P       &kp LBKT  &kp RBKT   &kp BSLH             &rgb_ug RGB_TOG
          &to 1     &kp CAPSLOCK   &kp A               &kp S    &kp D     &kp F     &kp G      &kp H     &kp J     &kp K    &kp L      &kp SEMI    &kp SQT              &kp ENTER            &rgb_ug RGB_EFR
                    &kp LSHFT                          &kp Z    &kp X     &kp C     &kp V      &kp B     &kp N     &kp M    &kp COMMA  &kp DOT     &kp FSLH             &kp RSHFT  &kp UP 
                    &kp LCTRL                &kp LGUI           &kp LALT            &kp SPACE            &kp SPACE          &kp RALT   &mo 2                 &kp RCTRL  &kp LEFT   &kp DOWN  &kp RIGHT
            >; 
        };

        fn_layer {
            display-name = "MacBook";
            bindings = <
          &kp ESC   &kp TILDE      &kp N1    &kp N2    &kp N3   &kp N4    &kp N5    &kp N6     &kp N7    &kp N8    &kp N9   &kp N0     &kp MINUS   &kp EQUAL            &kp BSPC             &kp DEL
          &trans    &kp TAB        &kp Q               &kp W    &kp E     &kp R     &kp T      &kp Y     &kp U     &kp I    &kp O      &kp P       &kp LBKT  &kp RBKT   &kp BSLH             &rgb_ug RGB_TOG
          &to 0     &kp CAPSLOCK   &kp A               &kp S    &kp D     &kp F     &kp G      &kp H     &kp J     &kp K    &kp L      &kp SEMI    &kp SQT              &kp ENTER            &rgb_ug RGB_EFR
                    &kp LSHFT                          &kp Z    &kp X     &kp C     &kp V      &kp B     &kp N     &kp M    &kp COMMA  &kp DOT     &kp FSLH             &kp RSHFT  &kp UP 
                    &kp LCTRL                &kp LALT           &kp LGUI            &kp SPACE            &kp SPACE          &kp RCTRL  &mo 2                 &kp RGUI   &kp LEFT   &kp DOWN  &kp RIGHT
            >;
        };

        tri_layer {
            display-name = "Function";
            bindings = <
          &rgb_ug RGB_SAI   &trans   &trans  &trans  &trans   &trans   &trans   &trans   &trans  &trans   &trans   &trans   &trans   &trans            &trans          &rgb_ug RGB_SAD
          &rgb_ug RGB_HUI   &trans   &trans          &trans   &trans   &trans   &trans   &trans  &trans   &trans   &trans   &trans   &trans   &trans   &trans          &rgb_ug RGB_HUD
          &rgb_ug RGB_BRI   &trans   &trans          &trans   &trans   &trans   &trans   &trans  &trans   &trans   &trans   &trans   &trans            &trans          &rgb_ug RGB_BRD
                            &trans                   &trans   &trans   &trans   &trans   &trans  &trans   &trans   &trans   &trans   &trans            &trans  &trans 
                            &trans           &trans           &trans            &trans           &trans            &trans   &trans            &trans   &trans  &trans  &trans
            >;
        };
    };
};
