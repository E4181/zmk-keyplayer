if SHIELD_KEYPLAYER

config ZMK_KEYBOARD_NAME
    default "keyplayer"
      
endif

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT


menuconfig ZMK_LAYER_STATE_MANAGER
    bool "Layer State Manager"
    default y
    help
      Enable layer state manager for monitoring layer changes.


config ZMK_BEHAVIOR_LAYER_LED_INDICATOR
    bool "Enable layer LED indicator behavior"
    default y
    help
      Blinks an LED when switching to a specific layer

# Charging Status Driver Configuration

menuconfig CHARGING_STATUS
    bool "TP4056 Charging Status Driver (Hardcoded P1.09)"
    default y
    help
      Enable driver for TP4056 charging status detection on P1.09.

if CHARGING_STATUS

config CHARGING_STATUS_LOG_LEVEL
    int "Log level"
    default 2
    range 0 4
    help
      Log level for charging status driver.
      0=OFF, 1=ERROR, 2=WARN, 3=INFO, 4=DEBUG

endif # CHARGING_STATUS