if SHIELD_KEYPLAYER

config ZMK_KEYBOARD_NAME
    default "keyplayer"
      
endif

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT


menuconfig ZMK_LAYER_STATE_MANAGER
    bool "Layer State Manager"
    default y
    help
      Enable layer state manager for monitoring layer changes.


config ZMK_BEHAVIOR_LAYER_LED_INDICATOR
    bool "Enable layer LED indicator behavior"
    default y
    help
      Blinks an LED when switching to a specific layer


menuconfig CHARGING_MONITOR
    bool "TP4056 Charging Status Monitor"
    default y
    help
      Enable monitoring of TP4056 charging status via CHRG pin.
      Includes LED indicator support.

if CHARGING_MONITOR

config CHARGING_MONITOR_LOG_LEVEL
    int "Log level"
    range 0 4
    default 2
    help
      Sets log level for charging monitor driver.
      
      0=OFF, 1=ERROR, 2=WARNING, 3=INFO, 4=DEBUG

config CHARGING_MONITOR_INIT_PRIORITY
    int "Init priority"
    default 90
    help
      Charging monitor device driver initialization priority.

config CHARGING_MONITOR_LED_ENABLE
    bool "Enable LED indicator"
    default y
    help
      Enable LED indicator that shows charging status.
      LED is ON when charging, OFF when not charging.

endif # CHARGING_MONITOR

menuconfig CHARGING_LED
    bool "Charging Status LED Indicator"
    default y
    help
      Enable LED indicator for charging status.
      LED is ON when charging, OFF when not charging.

if CHARGING_LED

config CHARGING_LED_LOG_LEVEL
    int "Log level"
    range 0 4
    default 2
    help
      Sets log level for charging LED driver.
      
      0=OFF, 1=ERROR, 2=WARNING, 3=INFO, 4=DEBUG

config CHARGING_LED_INIT_PRIORITY
    int "Init priority"
    default 91
    help
      Charging LED device driver initialization priority.
      Should be after charging monitor (priority 90).

endif # CHARGING_LED