if SHIELD_KEYPLAYER

config ZMK_KEYBOARD_NAME
    default "keyplayer"
      
endif

if ZMK_BACKLIGHT

config PWM
    default y

config LED_PWM
    default y

endif # ZMK_BACKLIGHT

DT_COMPAT_ZMK_TP4056_CHARGER := zmk,tp4056-charger

config ZMK_BATTERY_TP4056_CHARGER
    bool "TP4056 Charger Status Sensor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_TP4056_CHARGER))
    select ZMK_SENSOR
    select SENSOR
    help
        Enable TP4056 charger status detection via CHRG pin with LED indicator.

        

menuconfig ZMK_LAYER_STATE_MANAGER
    bool "Layer State Manager"
    default y
    help
      Enable layer state manager for monitoring layer changes.


config ZMK_BEHAVIOR_LAYER_LED_INDICATOR
    bool "Enable layer LED indicator behavior"
    default y
    help
      Blinks an LED when switching to a specific layer